# Kopieer dit bestand naar .env en vul de echte waarden in.
# Voeg .env toe aan .gitignore!

# Flask
SECRET_KEY=kies-een-lang-willekeurig-geheim-hier
FLASK_ENV=development
FLASK_DEBUG=1

# Database (Lokaal: SQLite of PostgreSQL op Proxmox)
DATABASE_URL=postgresql://digidokters:wachtwoord@192.168.1.xxx:5432/digidokters?sslmode=disable
# DATABASE_URL=sqlite:///digidokters.db

# Optioneel: PostgreSQL schema keuze ('public' voor testdata, 'productie' voor productiekopie)
# DB_SCHEMA=public

# Optioneel: Supabase Productie Database connectie (gebruikt voor directe live sync via scripts/sync_productie_naar_lokaal.py)
# PROD_DATABASE_URL=postgresql://postgres:[WACHTWOORD]@[PROJECT-HOST].supabase.co:5432/postgres

# E-mail instellingen
# Optie A: Brevo HTTPS REST API (Aanbevolen op Render.com - omzeilt SMTP poort-blokkades op poort 443)
# BREVO_API_KEY=xkeysib-xxxxxxxxx

# Optie B: Traditionele SMTP
# SMTP_SERVER=smtp-relay.brevo.com
# SMTP_PORT=465
# SMTP_USERNAME=jouw_login
# SMTP_PASSWORD=jouw_wachtwoord
# SMTP_SENDER=digidokters@gmail.com

# Lokale test / Dev e-mail veiligheid (omleiden van ALLE uitgaande e-mails naar één adres):
# MAIL_OVERRIDE_RECIPIENT=jouw.eigen.email@domein.com

