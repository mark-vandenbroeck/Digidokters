# Kopieer dit bestand naar .env en vul de echte waarden in.
# Voeg .env toe aan .gitignore!

# Flask
SECRET_KEY=kies-een-lang-willekeurig-geheim-hier
FLASK_ENV=development
FLASK_DEBUG=1

# Database
DATABASE_URL=sqlite:///digidokters.db

# E-mail instellingen
# Optie A: Brevo HTTPS REST API (Aanbevolen op Render.com - omzeilt SMTP poort-blokkades op poort 443)
# BREVO_API_KEY=xkeysib-xxxxxxxxx

# Optie B: Traditionele SMTP
# SMTP_SERVER=smtp-relay.brevo.com
# SMTP_PORT=465
# SMTP_USERNAME=jouw_login
# SMTP_PASSWORD=jouw_wachtwoord
# SMTP_SENDER=digidokters@gmail.com

