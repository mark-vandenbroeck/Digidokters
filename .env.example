# Kopieer dit bestand naar .env en vul de echte waarden in.
# Voeg .env toe aan .gitignore!

# Flask
SECRET_KEY=kies-een-lang-willekeurig-geheim-hier
FLASK_ENV=development
FLASK_DEBUG=1

# Database
# Lokaal (SQLite, standaard – geen aanpassing nodig):
# DATABASE_URL=sqlite:///digidokters.db

# Supabase / PostgreSQL (productie):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=sqlite:///digidokters.db
